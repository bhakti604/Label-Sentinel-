# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OCR & Computer Vision Engine Configuration
# Tesseract.js runs 100% in-browser WebAssembly. Set worker logging for debugging:
NEXT_PUBLIC_ENABLE_OCR_WORKER_LOGGING=false

# Regulatory Engine Runtime Environment
NEXT_PUBLIC_SENTINEL_ENV=development

# Future Backend / Firebase Configuration (Prepared Placeholders - Week 3 Scope)
# Do NOT place actual private keys or live cloud credentials in source control.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=label-sentinel-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=label-sentinel-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=label-sentinel-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

